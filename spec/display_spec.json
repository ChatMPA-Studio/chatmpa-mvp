{
  "_comment": "Machine-readable KPI + plot spec for the chatMPA dashboard. Engineers use this to know what to render per skill. Biomass unit is T/ha (1 T/ha = 100 g/m²). See DASHBOARD.md for full display guidance.",
  "_generated": "2026-08-17",
  "_design_change": "MPA panel and Fisheries Office panel are now separate. CONAPESCA CPUE moved entirely to Panel B (office click). MPA panel (Panel A) shows only LTEM + environmental data. Panel B adds species/group selector and economic KPI placeholders.",
  "_interpretation_schema": {
    "_note": "Every skill now returns an 'interpretation' block alongside its numerical output. Schema is identical across all skills except conapesca-cpue (which has per-fleet sub-blocks under 'menores' / 'mayores'). Fields:",
    "before_period": "integer[2] — c(year_start, year_end) of the reference period",
    "after_period":  "integer[2] — c(year_start, year_end) of the recent period",
    "metric_before": "numeric — mean of the primary KPI metric in the before period",
    "metric_after":  "numeric — mean in the after period",
    "delta":         "numeric — after_mean − before_mean (native units)",
    "pct_change":    "numeric — (delta / |before|) × 100, or null if before ≈ 0",
    "direction":     "string — 'increasing' | 'decreasing' | 'stable'",
    "status":        "string — 'positive' | 'neutral' | 'negative' | 'ambiguous'",
    "significance":  "object — Mann-Kendall result: {method, tau, p, direction} or {status: 'insufficient_data'}",
    "stress_years_recent": "(SST only) integer — count of recent years exceeding +0.5°C anomaly threshold",
    "insight_es":    "string — one-sentence Spanish ecological insight",
    "insight_en":    "string — one-sentence English ecological insight",
    "_status_logic": {
      "ltem-fish-biomass":    "positive if increasing + MK p<0.10; negative if decreasing + p<0.10; else neutral",
      "ltem-nrsi-index":      "positive if after>0 AND increasing; negative if after<-0.15 OR (delta<-0.1 AND p<0.10); else neutral",
      "erddap-sst-anomaly":   "negative if ≥3 of last 5 years exceed +0.5°C; positive if ≤0 stress years AND |delta|≤0.1°C; else neutral",
      "erddap-chlorophyll":   "always ambiguous — direction alone not ecological signal",
      "conapesca-cpue":       "always ambiguous — CPUE paradox: declining CPUE may reflect effort change or stock depletion"
    }
  },
  "skills": [
    {
      "skill": "ltem-fish-biomass",
      "source": "LTEM MCP",
      "display": "both",
      "kpi": {
        "label": "FISH BIOMASS",
        "metric": "mean_biomass",
        "unit": "T/ha",
        "aggregation": "5-year mean of annual means",
        "panel_card_index": 1,
        "format": "toFixed(2)",
        "sub": "Mean · 5-yr surveys · LTEM",
        "scale": "MPA (LTEM region)",
        "null_display": "—"
      },
      "plot": {
        "type": "stacked_area",
        "title": "Fish Biomass — Trophic Structure",
        "y_axis_label": "T/ha",
        "y_min": 0,
        "stack_key": "biomass",
        "series": [
          { "id": "GenPred_solitary",  "label": "Depredadores solitarios",    "color": "#D73027", "source_field": "functional_groups.series.Depredadores solitarios" },
          { "id": "GenPred_schooling", "label": "Depredadores en cardúmenes", "color": "#FC8D59", "source_field": "functional_groups.series.Depredadores en cardúmenes" },
          { "id": "EpiBent_schooling", "label": "Omnívoros en cardúmen",      "color": "#FEE08B", "source_field": "functional_groups.series.Omnívoros en cardúmen" },
          { "id": "Crip_schooling",    "label": "Herbívoros en cardúmen",     "color": "#91BFDB", "source_field": "functional_groups.series.Herbívoros en cardúmen" },
          { "id": "Crip_solitary",     "label": "Crípticos solitarios",       "color": "#4575B4", "source_field": "functional_groups.series.Crípticos solitarios" },
          { "id": "Plank",             "label": "Planctívoros",               "color": "#313695", "source_field": "functional_groups.series.Planctívoros" }
        ],
        "fill_opacity": 0.8,
        "tension": 0.3,
        "point_radius": 0,
        "legend_position": "bottom",
        "legend_reverse": true,
        "height_px": 190,
        "fallback": {
          "condition": "functional_groups is null AND biomass exists",
          "type": "line_with_scatter",
          "title": "Fish Biomass — GAM Trend",
          "height_px": 155,
          "series": [
            {
              "id": "observed",
              "label": "Annual mean",
              "source_field": "biomass.annual_means.mean_biomass_g_m2",
              "type": "scatter",
              "color": "#0B2338",
              "point_border": "white"
            },
            {
              "id": "gam_fit",
              "label": "GAM trend",
              "source_field": "biomass.trend.fit",
              "type": "line",
              "color": "#1E9EC4",
              "width_px": 2
            },
            {
              "id": "gam_ci",
              "label": "95% CI",
              "source_fields": ["biomass.trend.lwr", "biomass.trend.upr"],
              "type": "area_band",
              "color": "rgba(30,158,196,0.15)"
            }
          ],
          "annotations": [
            { "condition": "dev_expl_pct exists", "text": "GAM dev.expl.: {dev_expl_pct}%", "color": "#808E97" }
          ]
        },
        "scale": "MPA (LTEM region)"
      },
      "data_path": "mpa_data.{mpa_name}",
      "notes": "Primary display: functional_groups stacked area. Fallback to GAM trend if functional_groups is absent. Field 'mean_biomass_g_m2' stores T/ha — display as T/ha."
    },
